---
layout: null
permalink: /search.json
sitemap: false
search: false
---
[
    {% assign records = site.posts %
    }
{% if site.episodes.size > 0 %
    }{% assign records = records | concat: site.episodes %
    }{% endif %
    }
{% assign records = records | concat: site.pages %
    }
{% assign separator = '' %
    }
{% for record in records %
    }
    {% if record.search == false or record.title == nil or record.layout == nil or record.url == '/404.html' %
    }{% continue %
    }{% endif %
    }
    {% assign suffix = record.url | slice: -1,
        1 %
    }
    {% unless record.collection or suffix == '/' or record.url contains '.html' %
    }{% continue %
    }{% endunless %
    }
    {% assign kind = 'Page' %
    }
    {% if record.collection == 'posts' %
    }{% assign kind = 'Article' %
    }{% elsif record.collection == 'episodes' %
    }{% assign kind = 'Episode' %
    }{% endif %
    }
    {% assign summary = record.description | default: record.subtitle | default: record.excerpt | strip_html | normalize_whitespace %
    }
    {% assign profile = site.data.authors[record.author
        ] %
    }
    {% capture keywords %
    }{
        { record.categories | join: ' '
        }
    } {
        { record.tags | join: ' '
        }
    } {
        { profile.name | default: record.author
        }
    } {
        { record.subtitle
        }
    }{% endcapture %
    }
    {
        { separator
        }
    }{
        "title": {
            { record.title | jsonify
            }
        },
        "url": {
            { record.url | relative_url | jsonify
            }
        },
        "kind": {
            { kind | jsonify
            }
        },
        "description": {
            { summary | truncatewords: 45 | jsonify
            }
        },
        "keywords": {
            { keywords | normalize_whitespace | jsonify
            }
        },
        "text": {% if record.collection %
        }{
            { record.content | strip_html | normalize_whitespace | jsonify
            }
        }{% else %
        }{
            { summary | jsonify
            }
        }{% endif %
        }
    }
    {% assign separator = ',' %
    }
{% endfor %
    }
]